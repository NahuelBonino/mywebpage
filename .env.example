# ── Chatbot ────────────────────────────────────────────────────────────────
# Copiá este archivo como `.env` y completá los valores.

# URL del endpoint del chatbot (sin barras raras, incluye la barra final si tu backend la requiere)
VITE_CHATBOT_URL=https://TU-BACKEND/portfolio-chatbot/

# Token de autorización (Bearer) para el endpoint
VITE_PORTFOLIO_TOKEN=TU-TOKEN-AQUI
