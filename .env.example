# ── Chatbot server-side ────────────────────────────────────────────────────
# Configurá estas variables únicamente en el entorno del servidor
# (por ejemplo, Vercel Project Settings), nunca como variables VITE_*.

# URL del endpoint del chatbot (debe usar HTTPS)
CHATBOT_URL=https://TU-BACKEND/portfolio-chatbot/

# Token de autorización (Bearer) para el endpoint
PORTFOLIO_TOKEN=TU-TOKEN-AQUI
